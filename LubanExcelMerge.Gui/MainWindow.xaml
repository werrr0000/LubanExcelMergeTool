<Window x:Class="LubanExcelMerge.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cli="clr-namespace:LubanExcelMerge.Cli;assembly=LubanExcelMerge"
        xmlns:local="clr-namespace:LubanExcelMerge.Gui"
        mc:Ignorable="d"
        Icon="Assets/LubanExcelMerge.ico"
        Title="Luban Excel 合并" Width="1600" Height="960"
        MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="F7" Modifiers="Shift" Command="{Binding PreviousCommand}" />
        <KeyBinding Key="F7" Command="{Binding NextCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#202B33" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Luban Excel 合并" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    <Border Width="1" Height="24" Background="#53616D" Margin="18,0" />
                    <TextBlock Foreground="#C9D2D8" VerticalAlignment="Center">
                        <Run Text="逻辑表  " /><Run Text="{Binding LogicalTable, Mode=OneWay}" Foreground="White" />
                        <Run Text="    工作表  " /><Run Text="{Binding SheetName, Mode=OneWay}" Foreground="White" />
                        <Run Text="    主键  " /><Run Text="{Binding KeyName, Mode=OneWay}" Foreground="White" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AutomaticEditCount, StringFormat=自动 {0}}" Foreground="#9ED7C0" Margin="0,0,18,0" />
                    <TextBlock Text="{Binding ResolvedCount, StringFormat=已解决 {0}}" Foreground="#93C5FD" Margin="0,0,18,0" />
                    <TextBlock Text="{Binding RemainingCount, StringFormat=未解决 {0}}" Foreground="#FFB4AB" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="7" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="7" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="7" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="BASE" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BasePath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="0" Grid.Column="2" Command="{Binding BrowseBaseCommand}" Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="选择 BASE 工作簿" AutomationProperties.Name="选择 BASE 工作簿" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="LOCAL" VerticalAlignment="Center" FontWeight="SemiBold" Margin="16,0,0,0" />
                <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding LocalPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="0" Grid.Column="5" Command="{Binding BrowseLocalCommand}" Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="选择 LOCAL 工作簿" AutomationProperties.Name="选择 LOCAL 工作簿" />

                <TextBlock Grid.Row="2" Text="REMOTE" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RemotePath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="2" Grid.Column="2" Command="{Binding BrowseRemoteCommand}" Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="选择 REMOTE 工作簿" AutomationProperties.Name="选择 REMOTE 工作簿" />
                <TextBlock Grid.Row="2" Grid.Column="3" Text="MERGED" VerticalAlignment="Center" FontWeight="SemiBold" Margin="16,0,0,0" />
                <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="2" Grid.Column="5" Command="{Binding BrowseOutputCommand}" Style="{StaticResource IconButton}" Content="&#xE74E;" ToolTip="选择 MERGED 输出" AutomationProperties.Name="选择 MERGED 输出" />

                <TextBlock Grid.Row="4" Text="仓库根目录" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding RepositoryRoot, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="4" Grid.Column="3" Text="数据根目录" VerticalAlignment="Center" Margin="16,0,0,0" />
                <TextBox Grid.Row="4" Grid.Column="4" Grid.ColumnSpan="2" Text="{Binding DataRoot, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="6" Text="表注册文件" VerticalAlignment="Center" />
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding TablesPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="6" Grid.Column="2" Command="{Binding BrowseTablesCommand}" Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="选择 __tables__.csv" AutomationProperties.Name="选择表注册文件" />
                <TextBlock Grid.Row="6" Grid.Column="3" Text="公式重算" VerticalAlignment="Center" Margin="16,0,0,0" />
                <ComboBox Grid.Row="6" Grid.Column="4" Width="174" HorizontalAlignment="Left"
                          ItemsSource="{Binding RecalculationModes}"
                          SelectedItem="{Binding SelectedRecalculationMode}"
                          DisplayMemberPath="DisplayName"
                          AutomationProperties.Name="公式重算模式" />
                <Button Grid.Row="6" Grid.Column="4" Grid.ColumnSpan="2" HorizontalAlignment="Right"
                        Width="128" Background="{StaticResource AccentBrush}" Foreground="White"
                        BorderBrush="{StaticResource AccentBrush}" Command="{Binding LoadCommand}" AutomationProperties.Name="分析合并">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,0,8,0" />
                        <TextBlock Text="分析合并" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#F1F4F6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource IconButton}" Command="{Binding UndoCommand}" Content="&#xE7A7;" ToolTip="撤销 (Ctrl+Z)" AutomationProperties.Name="撤销" />
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding RedoCommand}" Content="&#xE7A6;" ToolTip="重做 (Ctrl+Y)" AutomationProperties.Name="重做" Margin="4,0,0,0" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Border Width="14" Height="14" Background="#FFD9D6" BorderBrush="#D8A6A1" BorderThickness="1" />
                    <TextBlock Text="冲突" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Border Width="14" Height="14" Background="#FFF0BF" BorderBrush="#D7C27B" BorderThickness="1" />
                    <TextBlock Text="删除" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Border Width="14" Height="14" Background="#DDF3E4" BorderBrush="#91C5A1" BorderThickness="1" />
                    <TextBlock Text="新增" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="14" Height="14" Background="#E8F2FA" BorderBrush="#9EBFD8" BorderThickness="1" />
                    <TextBlock Text="自动合并" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="18,0,0,0">
                    <Border Width="14" Height="14" Background="#FFE2B8" BorderBrush="#D89A45" BorderThickness="1" />
                    <TextBlock Text="元数据复核" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="8" Orientation="Horizontal">
                    <Button Width="42" Style="{StaticResource IconButton}" Command="{Binding ExportDiagnosticsCommand}"
                            Content="&#xE74E;" ToolTip="导出诊断包（不含工作簿）" AutomationProperties.Name="导出诊断包" Margin="0,0,6,0" />
                    <Button Width="94" Command="{Binding CancelCommand}" ToolTip="取消合并并关闭" AutomationProperties.Name="取消合并" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" Margin="0,0,7,0" />
                            <TextBlock Text="取消合并" />
                        </StackPanel>
                    </Button>
                    <Button Width="126" Background="{StaticResource SuccessBrush}" Foreground="White"
                            BorderBrush="{StaticResource SuccessBrush}" Command="{Binding SaveCommand}" ToolTip="保存 MERGED (Ctrl+S)" AutomationProperties.Name="保存 MERGED">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" Margin="0,0,8,0" />
                            <TextBlock Text="保存 MERGED" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="220" />
                <RowDefinition Height="6" />
                <RowDefinition Height="*" MinHeight="190" />
            </Grid.RowDefinitions>
            <TabControl Grid.Row="0" Height="42" Margin="0,0,0,8"
                        ItemsSource="{Binding SheetTabs}"
                        SelectedItem="{Binding SelectedSheet, Mode=TwoWay}"
                        AutomationProperties.Name="工作表切换">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" MinWidth="96">
                            <TextBlock Text="{Binding SheetName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="#E8EDF1" BorderBrush="#CBD3DA" BorderThickness="1"
                                    CornerRadius="4" Margin="8,0,0,0" Padding="6,1"
                                    ToolTip="该工作表未解决冲突数">
                                <TextBlock Text="{Binding RemainingCount}" FontSize="12" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate><Border Height="0" /></DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#EEF1F4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                            <TextBlock Text="BASE" FontWeight="SemiBold" />
                        </Border>
                        <local:SpreadsheetGrid x:Name="BaseSpreadsheet" Table="{Binding BaseGrid}" />
                    </DockPanel>
                </Border>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#EEF1F4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                            <TextBlock Text="LOCAL" FontWeight="SemiBold" />
                        </Border>
                        <local:SpreadsheetGrid x:Name="LocalSpreadsheet" Table="{Binding LocalGrid}" />
                    </DockPanel>
                </Border>
                <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />
                <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#EEF1F4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                            <TextBlock Text="REMOTE" FontWeight="SemiBold" />
                        </Border>
                        <local:SpreadsheetGrid x:Name="RemoteSpreadsheet" Table="{Binding RemoteGrid}" />
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#D8DDE3" />

            <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#EEF1F4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="10,8" Text="MERGED" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Grid.Column="1" Margin="12,8" Text="{Binding SelectedConflict.Message}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,4">
                            <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0" />
                            <Button Content="上一处" Command="{Binding PreviousCommand}" Margin="0,0,6,0" AutomationProperties.Name="上一处" />
                            <Button Content="下一处" Command="{Binding NextCommand}" Margin="0,0,14,0" AutomationProperties.Name="下一处" />
                            <Button Style="{StaticResource ChoiceButton}" Content="接受 BASE" Command="{Binding ResolveCommand}" CommandParameter="{x:Static cli:MergeChoice.Base}" AutomationProperties.Name="接受 BASE" />
                            <Button Style="{StaticResource ChoiceButton}" Content="接受 LOCAL" Command="{Binding ResolveCommand}" CommandParameter="{x:Static cli:MergeChoice.Local}" AutomationProperties.Name="接受 LOCAL" />
                            <Button Style="{StaticResource ChoiceButton}" Content="接受 REMOTE" Command="{Binding ResolveCommand}" CommandParameter="{x:Static cli:MergeChoice.Remote}" AutomationProperties.Name="接受 REMOTE" />
                        </StackPanel>
                    </Grid>
                    <local:SpreadsheetGrid x:Name="MergedSpreadsheet" Grid.Row="1" Table="{Binding MergedGrid}" />
                </Grid>
            </Border>
        </Grid>

        <StatusBar Grid.Row="4" Background="#202B33" Foreground="White" Padding="8,3">
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <Button Command="{Binding NavigateAutomaticEditCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        Padding="0"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                        HorizontalContentAlignment="Left"
                        ToolTip="定位下一处自动编辑（循环）"
                        AutomationProperties.Name="循环定位自动编辑">
                    <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                </Button>
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding ConflictCount, StringFormat=冲突总数 {0}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
